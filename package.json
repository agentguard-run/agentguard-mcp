{
  "name": "@agentguard-run/mcp",
  "version": "0.3.1",
  "description": "AgentGuard MCP server: local spend caps, kill-switch style blocking, and Ed25519-signed provenance receipts for AI agent actions. Zero data plane: prompts never pass through this server.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentguard-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs && AGENTGUARD_NO_BEACON=1 AGENTGUARD_LICENSE_KEY= AGENTGUARD_LICENSE_ENDPOINT=http://127.0.0.1:9 node test/smoke.mjs",
    "prepublishOnly": "npm test && npm run scan:release",
    "scan:release": "node scripts/release-scan.mjs"
  },
  "dependencies": {
    "@agentguard-run/spend": "^0.19.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ed25519": "^2.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent-security",
    "spend-control",
    "signed-receipts",
    "self-hosted-llm",
    "sovereign-ai",
    "ed25519",
    "local-first"
  ],
  "homepage": "https://agentguard.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerchantGuard/agentguard-mcp.git"
  },
  "mcpName": "io.github.MerchantGuard/agentguard",
  "engines": {
    "node": ">=20.19.0"
  }
}
